<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- No third-party PackageReference is used by this preview. SDK reference packs restore from the official feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
