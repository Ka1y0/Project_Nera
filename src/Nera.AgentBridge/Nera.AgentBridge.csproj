<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>ChipsStudio.Nera.AgentBridge</RootNamespace>
    <AssemblyName>Nera.AgentBridge</AssemblyName>
    <Version>0.5.0-alpha.2</Version>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-alpha.2-source-preview</InformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/Nera.AgentBridge</PathMap>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Nera.Localization\Nera.Localization.csproj" /></ItemGroup>
</Project>
